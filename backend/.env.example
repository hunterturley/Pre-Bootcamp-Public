# Backend-only secrets. NEVER ship these in the mobile bundle.

# Anthropic (Claude) — used to structure raw OCR text into contact fields.
ANTHROPIC_API_KEY=

# OCR provider. Use Google Cloud Vision (TEXT_DETECTION) ...
GOOGLE_VISION_KEY=
# ... or AWS Textract instead (set provider=textract in lib/ocr.ts):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# GoHighLevel (LeadConnector) API v2 OAuth app credentials.
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Per-deploy default location token (v1 single sub-account). For multi-team,
# resolve the agent -> location mapping from the session token instead.
GHL_LOCATION_API_KEY=
GHL_LOCATION_ID=

# Model id for the parse layer.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
